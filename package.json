{
  "name": "simple-sport",
  "version": "0.1.0",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "nx": "nx",
    "start": "nx serve simple-sport",
    "build": "nx build simple-sport",
    "test": "nx run-many -t test --watch=false",
    "lint": "nx run-many -t lint",
    "lint:fix": "nx run-many -t lint -- --fix",
    "lint:styles": "stylelint \"{apps,libs}/**/*.{css,scss}\"",
    "lint:styles:fix": "stylelint \"{apps,libs}/**/*.{css,scss}\" --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pretty": "prettier --write . && eslint . --fix && stylelint \"{apps,libs}/**/*.{css,scss}\" --fix",
    "mobile:sync": "yarn build && yarn cap sync",
    "mobile:android:sync": "yarn build && yarn cap sync android",
    "mobile:ios:sync": "yarn build && yarn cap sync ios",
    "mobile:ios": "yarn mobile:ios:sync && yarn cap open ios",
    "mobile:android": "yarn mobile:android:sync && yarn cap open android",
    "mobile:android:apk": "yarn mobile:android:sync && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@angular/animations": "^21.0.0",
    "@angular/cdk": "^21.0.0",
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/material": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "@angular/platform-browser-dynamic": "^21.0.0",
    "@angular/router": "^21.0.0",
    "@capacitor-community/sqlite": "^7.0.1",
    "@capacitor/core": "^7.6.8",
    "@capacitor/keyboard": "^7.0.6",
    "@ngrx/signals": "^21.0.0",
    "echarts": "^5.5.1",
    "jeep-sqlite": "^2.8.0",
    "rxjs": "^7.8.1",
    "sql.js": "1.11.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.0.0",
    "@angular-devkit/core": "^21.0.0",
    "@angular-devkit/schematics": "^21.0.0",
    "@angular-eslint/builder": "^21.0.0",
    "@angular-eslint/eslint-plugin": "^21.0.0",
    "@angular-eslint/eslint-plugin-template": "^21.0.0",
    "@angular-eslint/template-parser": "^21.0.0",
    "@angular/build": "^21.0.0",
    "@angular/cli": "^21.0.0",
    "@angular/compiler-cli": "^21.0.0",
    "@capacitor/android": "^7.6.8",
    "@capacitor/cli": "^7.6.8",
    "@capacitor/ios": "^7.6.8",
    "@eslint/js": "^10.0.1",
    "@nx/angular": "23.1.1",
    "@nx/eslint": "23.1.1",
    "@nx/eslint-plugin": "23.1.1",
    "@nx/workspace": "23.1.1",
    "@schematics/angular": "^21.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "nx": "23.1.1",
    "postcss": "^8.5.26",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.3.3",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-prettier": "^5.0.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.0.0",
    "vitest": "^5.0.0"
  },
  "overrides": {}
}
